{
  "_note": "DRAFT (phase 0). One entry per comparison in section 6.1 of BUILD_PROMPT.md. match = max(0, 1 - |earth - target| / range). Each body side says how to get a 0..1 or physical value from feature-CSV columns. Ops: col, sum, diff, const, skip; optional div, cap, log10, scale [lo,hi]. 'dimensions' lists every dimension the comparison counts toward. Ranges are STARTING values, tuned in phase 5 and recorded in METHODS.md.",
  "version": 0,
  "dimensions": {
    "geology":      "Geology, mineralogy, and surface materials",
    "terrain":      "Terrain, elevation, slope, roughness, craters, and other topographic features",
    "thermal":      "Temperature, illumination, and environmental extremes",
    "water":        "Water, ice, permafrost, and other potential resources",
    "dust":         "Dust, wind, erosion, and other atmospheric or surface processes",
    "habitability": "Biology, extremophiles, habitability, and biosignatures",
    "subsurface":   "Caves, lava tubes, underground environments, and other subsurface features",
    "operations":   "Conditions relevant to landing, mobility, navigation, robotic operations, human exploration, or construction"
  },
  "comparisons": [
    { "id": "slope",       "label": "Slope",              "dimensions": ["terrain", "operations"], "range": 6,   "unit": "deg",
      "earth": {"op": "col", "col": "slope_mean_deg"}, "moon": {"op": "col", "col": "slope_mean_deg"}, "mars": {"op": "col", "col": "slope_mean_deg"} },
    { "id": "roughness",   "label": "Roughness",          "dimensions": ["terrain"], "range": 400,  "unit": "m",
      "earth": {"op": "col", "col": "roughness_m"}, "moon": {"op": "col", "col": "roughness_m"}, "mars": {"op": "col", "col": "roughness_m"} },
    { "id": "relief",      "label": "Relief",             "dimensions": ["terrain"], "range": 2500, "unit": "m",
      "earth": {"op": "col", "col": "relief_m"}, "moon": {"op": "col", "col": "relief_m"}, "mars": {"op": "col", "col": "relief_m"} },
    { "id": "cratering",   "label": "Cratering",          "dimensions": ["terrain"], "range": 0.6,  "unit": "idx",
      "earth": {"op": "col", "col": "crater_prox_idx"}, "moon": {"op": "col", "col": "crater_density_20km_n", "scale": "body_range"}, "mars": {"op": "col", "col": "crater_density_20km_n", "scale": "body_range"} },
    { "id": "basaltic",    "label": "Basaltic ground",    "dimensions": ["geology"], "range": 0.6,  "unit": "idx",
      "earth": {"op": "col", "col": "lith_basic_volcanic_pct", "div": 100}, "moon": {"op": "col", "col": "mare_idx"}, "mars": {"op": "col", "col": "geo_volcanic_pct", "div": 100, "times": "rockiness"} },
    { "id": "crystalline", "label": "Crystalline highlands", "dimensions": ["geology"], "range": 0.6, "unit": "idx",
      "earth": {"op": "sum", "cols": ["lith_plutonic_pct", "lith_metamorphic_pct"], "div": 100}, "moon": {"op": "oneminus", "col": "mare_idx"}, "mars": {"op": "col", "col": "geo_highland_pct", "div": 100} },
    { "id": "volcanic",    "label": "Volcanic activity",  "dimensions": ["geology"], "range": 0.7,  "unit": "idx",
      "earth": {"op": "col", "col": "volcano_prox_idx"}, "moon": {"op": "const", "value": 0.3}, "mars": {"op": "col", "col": "geo_volcanic_pct", "div": 100} },
    { "id": "temp_mean",   "label": "Mean temperature",   "dimensions": ["thermal"], "range": 40,   "unit": "C",
      "earth": {"op": "col", "col": "temp_mean_c"}, "moon": {"op": "col", "col": "temp_mean_c"}, "mars": {"op": "col", "col": "temp_mean_c"} },
    { "id": "temp_high",   "label": "Daily high",         "dimensions": ["thermal"], "range": 40,   "unit": "C",
      "earth": {"op": "col", "col": "temp_high_c"}, "moon": {"op": "col", "col": "temp_high_c"}, "mars": {"op": "col", "col": "temp_high_c"} },
    { "id": "temp_low",    "label": "Daily low",          "dimensions": ["thermal"], "range": 40,   "unit": "C",
      "earth": {"op": "col", "col": "temp_low_c"}, "moon": {"op": "col", "col": "temp_low_c"}, "mars": {"op": "col", "col": "temp_low_c"} },
    { "id": "temp_swing",  "label": "Daily swing",        "dimensions": ["thermal"], "range": 40,   "unit": "C",
      "earth": {"op": "diff", "cols": ["temp_high_c", "temp_low_c"]}, "moon": {"op": "diff", "cols": ["temp_high_c", "temp_low_c"]}, "mars": {"op": "diff", "cols": ["temp_high_c", "temp_low_c"]} },
    { "id": "sunlight",    "label": "Sunlight",           "dimensions": ["thermal"], "range": 0.5,  "unit": "idx",
      "earth": {"op": "col", "col": "solar_idx"}, "moon": {"op": "col", "col": "illum_idx"}, "mars": {"op": "col", "col": "illum_idx"} },
    { "id": "ice",         "label": "Ice availability",   "dimensions": ["water"], "range": 0.6,    "unit": "idx",
      "earth": {"op": "col", "col": "ice_idx"}, "moon": {"op": "col", "col": "water_idx"}, "mars": {"op": "col", "col": "water_idx"} },
    { "id": "dryness",     "label": "Dryness",            "dimensions": ["habitability", "dust"], "range": 0.6, "unit": "idx",
      "earth": {"op": "col", "col": "aridity_idx"}, "moon": {"op": "const", "value": 1}, "mars": {"op": "const", "value": 1} },
    { "id": "dust",        "label": "Dust activity",      "dimensions": ["dust"], "range": 0.6,    "unit": "idx",
      "earth": {"op": "col", "col": "dust_idx"}, "moon": {"op": "const", "value": 1}, "mars": {"op": "col", "col": "dust_cover_idx"} },
    { "id": "wind",        "label": "Wind and erosion",   "dimensions": ["dust"], "range": 0.7,    "unit": "idx",
      "earth": {"op": "col", "col": "wind_ms", "div": 10, "cap": 1}, "moon": {"op": "const", "value": 0}, "mars": {"op": "const", "value": 0.5} },
    { "id": "karst",       "label": "Karst and voids",    "dimensions": ["subsurface"], "range": 0.8, "unit": "idx",
      "earth": {"op": "col", "col": "karst_idx"}, "moon": {"op": "const", "value": 0}, "mars": {"op": "const", "value": 0.1} },
    { "id": "lavatube",    "label": "Lava-tube potential", "dimensions": ["subsurface"], "range": 0.6, "unit": "idx",
      "earth": {"op": "col", "col": "lavatube_idx"}, "moon": {"op": "col", "col": "lavatube_idx"}, "mars": {"op": "col", "col": "lavatube_idx"} },
    { "id": "barren",      "label": "Barrenness",         "dimensions": ["habitability"], "range": 0.5, "unit": "idx",
      "earth": {"op": "col", "col": "barren_pct", "div": 100}, "moon": {"op": "const", "value": 1}, "mars": {"op": "const", "value": 1} },
    { "id": "extremophile", "label": "Extremophile setting", "dimensions": ["habitability"], "range": 0.7, "unit": "idx",
      "earth": {"op": "col", "col": "aridity_idx"}, "moon": {"op": "const", "value": 1}, "mars": {"op": "const", "value": 1} },
    { "id": "pressure",    "label": "Surface pressure",   "dimensions": ["operations"], "range": 2.5, "unit": "decades",
      "earth": {"op": "col", "col": "pressure_hpa", "log10": true}, "moon": {"op": "skip"}, "mars": {"op": "col", "col": "pressure_pa", "div": 100, "log10": true} },
    { "id": "latitude",    "label": "Latitude (solar power)", "dimensions": ["operations"], "range": 0.4, "unit": "idx",
      "earth": {"op": "abslat", "div": 90}, "moon": {"op": "abslat", "div": 90}, "mars": {"op": "abslat", "div": 90} }
  ],
  "_notes_phase0": [
    "Derived columns (crater_prox_idx, volcano_prox_idx, water_idx, lavatube_idx, dust_idx, solar_idx, illum_idx, dust_cover_idx) are written into the feature CSVs by the phase scripts so score.js only reads columns.",
    "'extremophile' on Earth starts as aridity_idx; the curated flag for acidic, hypersaline or hydrothermal named sites overrides it for those sites (section 6.1).",
    "'landing elevation' (Mars only, below -2000 m = 1, above +2000 m = 0) is a target-side operations annotation, not a paired comparison, so it is not listed here.",
    "'rockiness' for Mars basaltic ground = clamp((thermal_inertia_tiu - 100) / 250, 0, 1)."
  ]
}
