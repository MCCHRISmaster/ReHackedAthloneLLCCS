{
  "_note": "Scoring config, read by pipeline/score_core.py and js/score.js. One entry per comparison (BUILD_PROMPT section 6.1). match = max(0, 1 - |earth - target| / range). A value spec is {op, ...}: col (optional fallback, div, times_scaled [col, lo, hi], cap, log10, scale 'body_range'), sum (cols, div), diff (cols), oneminus (col, div), const (value), abslat (div), skip. 'body_range' divides by the 99th percentile of that column on that body (out/feature_ranges.json). 'show' gives the quantity quoted in the plain-English loss sentences.",
  "version": 1,
  "min_available": 10,
  "dimensions": {
    "geology":      "Geology, mineralogy, and surface materials",
    "terrain":      "Terrain, elevation, slope, roughness, craters, and other topographic features",
    "thermal":      "Temperature, illumination, and environmental extremes",
    "water":        "Water, ice, permafrost, and other potential resources",
    "dust":         "Dust, wind, erosion, and other atmospheric or surface processes",
    "habitability": "Biology, extremophiles, habitability, and biosignatures",
    "subsurface":   "Caves, lava tubes, underground environments, and other subsurface features",
    "operations":   "Conditions relevant to landing, mobility, navigation, robotic operations, human exploration, or construction"
  },
  "comparisons": [
    { "id": "slope", "label": "Slope", "dimensions": ["terrain", "operations"], "range": 6, "unit": " degrees", "digits": 1,
      "earth": {"op": "col", "col": "slope_mean_deg"}, "moon": {"op": "col", "col": "slope_mean_deg"}, "mars": {"op": "col", "col": "slope_mean_deg"} },
    { "id": "roughness", "label": "Roughness", "dimensions": ["terrain"], "range": 400, "unit": " m", "digits": 0,
      "earth": {"op": "col", "col": "roughness_m"}, "moon": {"op": "col", "col": "roughness_m"}, "mars": {"op": "col", "col": "roughness_m"} },
    { "id": "relief", "label": "Relief", "dimensions": ["terrain"], "range": 2500, "unit": " m", "digits": 0,
      "earth": {"op": "col", "col": "relief_m"}, "moon": {"op": "col", "col": "relief_m"}, "mars": {"op": "col", "col": "relief_m"} },
    { "id": "cratering", "label": "Cratering", "dimensions": ["terrain"], "range": 0.6, "unit": "", "digits": 2, "index": true,
      "earth": {"op": "col", "col": "crater_prox_idx"}, "moon": {"op": "col", "col": "crater_density_5km_n", "scale": "body_range"}, "mars": {"op": "col", "col": "crater_density_5km_n", "scale": "body_range"} },
    { "id": "basaltic", "label": "Basaltic ground", "dimensions": ["geology"], "range": 0.6, "unit": "", "digits": 2, "index": true,
      "earth": {"op": "col", "col": "lith_basic_volcanic_pct", "div": 100}, "moon": {"op": "col", "col": "mare_idx"}, "mars": {"op": "col", "col": "geo_volcanic_pct", "div": 100, "times_scaled": ["thermal_inertia_tiu", 100, 350]} },
    { "id": "crystalline", "label": "Crystalline highlands", "dimensions": ["geology"], "range": 0.6, "unit": "", "digits": 2, "index": true,
      "earth": {"op": "sum", "cols": ["lith_plutonic_pct", "lith_metamorphic_pct"], "div": 100}, "moon": {"op": "oneminus", "col": "mare_idx"}, "mars": {"op": "col", "col": "geo_highland_pct", "div": 100} },
    { "id": "volcanic", "label": "Volcanic activity", "dimensions": ["geology"], "range": 1.0, "unit": "", "digits": 2, "index": true,
      "earth": {"op": "col", "col": "volcano_prox_idx"}, "moon": {"op": "const", "value": 0.3}, "mars": {"op": "col", "col": "geo_volcanic_pct", "div": 100} },
    { "id": "temp_mean", "label": "Mean temperature", "dimensions": ["thermal"], "range": 40, "unit": " C", "digits": 0,
      "earth": {"op": "col", "col": "temp_mean_c"}, "moon": {"op": "col", "col": "temp_mean_c"}, "mars": {"op": "col", "col": "temp_mean_c"} },
    { "id": "temp_high", "label": "Daily high", "dimensions": ["thermal"], "range": 40, "unit": " C", "digits": 0,
      "earth": {"op": "col", "col": "temp_high_c"}, "moon": {"op": "col", "col": "temp_high_c"}, "mars": {"op": "col", "col": "temp_high_c"} },
    { "id": "temp_low", "label": "Daily low", "dimensions": ["thermal"], "range": 40, "unit": " C", "digits": 0,
      "earth": {"op": "col", "col": "temp_low_c"}, "moon": {"op": "col", "col": "temp_low_c"}, "mars": {"op": "col", "col": "temp_low_c"} },
    { "id": "temp_swing", "label": "Daily temperature swing", "dimensions": ["thermal"], "range": 40, "unit": " C", "digits": 0,
      "earth": {"op": "diff", "cols": ["temp_high_c", "temp_low_c"]}, "moon": {"op": "diff", "cols": ["temp_high_c", "temp_low_c"]}, "mars": {"op": "diff", "cols": ["temp_high_c", "temp_low_c"]} },
    { "id": "sunlight", "label": "Sunlight", "dimensions": ["thermal"], "range": 0.5, "unit": "", "digits": 2, "index": true,
      "earth": {"op": "col", "col": "solar_idx"}, "moon": {"op": "col", "col": "illum_idx"}, "mars": {"op": "col", "col": "illum_idx"} },
    { "id": "ice", "label": "Ice and water availability", "dimensions": ["water"], "range": 0.6, "unit": "", "digits": 2, "index": true,
      "earth": {"op": "col", "col": "ice_idx"}, "moon": {"op": "col", "col": "water_idx"}, "mars": {"op": "col", "col": "water_idx"} },
    { "id": "dryness", "label": "Dryness", "dimensions": ["habitability", "dust"], "range": 0.6, "unit": "", "digits": 2, "index": true,
      "earth_show": {"col": "precip_mm_yr", "unit": " mm of rain a year", "digits": 0}, "target_show": "bone dry",
      "earth": {"op": "col", "col": "aridity_idx"}, "moon": {"op": "const", "value": 1}, "mars": {"op": "const", "value": 1} },
    { "id": "dust", "label": "Dust activity", "dimensions": ["dust"], "range": 0.6, "unit": "", "digits": 2, "index": true,
      "earth": {"op": "col", "col": "dust_idx"}, "moon": {"op": "const", "value": 1}, "mars": {"op": "col", "col": "dust_cover_idx"} },
    { "id": "wind", "label": "Wind and erosion", "dimensions": ["dust"], "range": 0.7, "unit": "", "digits": 2, "index": true,
      "earth_show": {"col": "wind_ms", "unit": " m/s average wind", "digits": 1},
      "earth": {"op": "col", "col": "wind_ms", "div": 10, "cap": 1}, "moon": {"op": "const", "value": 0}, "mars": {"op": "const", "value": 0.5} },
    { "id": "karst", "label": "Karst and voids", "dimensions": ["subsurface"], "range": 0.8, "unit": "", "digits": 2, "index": true,
      "earth": {"op": "col", "col": "karst_idx"}, "moon": {"op": "const", "value": 0}, "mars": {"op": "const", "value": 0.1} },
    { "id": "lavatube", "label": "Lava-tube potential", "dimensions": ["subsurface"], "range": 0.6, "unit": "", "digits": 2, "index": true,
      "earth": {"op": "col", "col": "lavatube_idx"}, "moon": {"op": "col", "col": "lavatube_idx"}, "mars": {"op": "col", "col": "lavatube_idx"} },
    { "id": "barren", "label": "Barren ground", "dimensions": ["habitability"], "range": 0.5, "unit": "", "digits": 2, "index": true,
      "earth": {"op": "col", "col": "barren_pct", "div": 100}, "moon": {"op": "const", "value": 1}, "mars": {"op": "const", "value": 1} },
    { "id": "extremophile", "label": "Extreme-life setting", "dimensions": ["habitability"], "range": 0.7, "unit": "", "digits": 2, "index": true,
      "earth": {"op": "col", "col": "extremophile_idx", "fallback": "aridity_idx"}, "moon": {"op": "const", "value": 1}, "mars": {"op": "const", "value": 1} },
    { "id": "pressure", "label": "Surface air pressure", "dimensions": ["operations"], "range": 2.5, "unit": " (log10 hPa)", "digits": 1,
      "earth_show": {"col": "pressure_hpa", "unit": " hPa", "digits": 0},
      "earth": {"op": "col", "col": "pressure_hpa", "log10": true}, "moon": {"op": "skip"}, "mars": {"op": "col", "col": "pressure_pa", "div": 100, "log10": true} },
    { "id": "latitude", "label": "Latitude (solar power)", "dimensions": ["operations"], "range": 0.4, "unit": "", "digits": 2, "index": true,
      "earth": {"op": "abslat", "div": 90}, "moon": {"op": "abslat", "div": 90}, "mars": {"op": "abslat", "div": 90} }
  ],
  "_notes": [
    "Moon and Mars cratering use crater_density_5km_n (2-degree cells hold too few 20 km craters to be a stable measure).",
    "Earth temperature columns come from NASA POWER (out/earth_grid_filled / work/power_temp_1deg.npz). Moon and Mars temperatures come from moon_data/moon_grid.csv and mars_data/mars_grid.csv, unchanged.",
    "Gravity, vacuum or thin air, radiation and the lunar night are never scored; see caveats.json.",
    "Landing elevation (Mars: below -2000 m is good, above +2000 m is bad) is a target-side annotation, not a paired comparison."
  ]
}
